 application "Event Registration System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form event_registrations
		{
			displayname = "Event Registrations"
			success message = "Event Registrations Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			participant_name
			(
    			type = name
				displayname = "Participant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			institution_address
			(
    			type = address
				displayname = "Institution Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			college_organization_name
			(
    			type = text
				displayname = "College Organization Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			expectations_from_event
			(
    			type = textarea
				displayname = "Expectations From Event"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			team_size
			(
				type = number
				displayname = "Team Size"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_session_date
			(
    			type = date
				displayname = "Preferred Session Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_session_slot
			(
    			type = time
				displayname = "Preferred Session Slot"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			event_track
			(
				type = picklist
				displayname = "Event Track"
				values = {"AI & Data Science","Cloud Computing","Cybersecurity","Robotics & Automation","Web Development"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			participant_type
			(
				type = picklist
				displayname = "Participant Type"
				values = {"Faculty","Professional","Student"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			areas_of_interest
			(
				type = list	
				displayname = "Areas Of Interest"
				values = {"Generative AI","Cloud Computing","Cybersecurity","Machine Learning","Web Development","Robotics"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			agree_to_code_of_conduct
			(
    			type = checkbox
				displayname = "Agree To Code Of Conduct"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Registration Submitted","Pending Review","Approved","Rejected","Pending Clarification","Registration Confirmed","Event Completed","Cancelled","Registration Closed"}
			}
		}
	}
	reports
	{
		list event_registrations_Report
		{
			displayName = "All Event Registrations"
			show all rows from event_registrations    
			(
				participant_name  as "Participant Name"
				institution_address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				email_address as "Email Address"
				contact_number as "Contact Number"
				college_organization_name as "College Organization Name"
				expectations_from_event as "Expectations From Event"
				team_size as "Team Size"
				preferred_session_date as "Preferred Session Date"
				preferred_session_slot as "Preferred Session Slot"
				event_track as "Event Track"
				participant_type as "Participant Type"
				areas_of_interest as "Areas Of Interest"
				agree_to_code_of_conduct as "Agree To Code Of Conduct"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (event_track == "Cloud Computing")
				fields = [event_track]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (event_track == "Robotics & Automation")
				fields = [event_track]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban event_registrations_by_event_track
		{
			displayName = "Event Tracks"
			show all rows from event_registrations    
			(
				participant_name  as "Participant Name"
				institution_address  as "Institution Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				email_address as "Email Address"
				contact_number as "Contact Number"
				college_organization_name as "College Organization Name"
				expectations_from_event as "Expectations From Event"
				team_size as "Team Size"
				preferred_session_date as "Preferred Session Date"
				preferred_session_slot as "Preferred Session Slot"
				event_track as "Event Track"
				participant_type as "Participant Type"
				areas_of_interest as "Areas Of Interest"
				agree_to_code_of_conduct as "Agree To Code Of Conduct"
			)
			options
			(
	 			display field = event_track
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
