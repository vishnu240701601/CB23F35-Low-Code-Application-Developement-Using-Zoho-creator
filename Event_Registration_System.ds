		workflow
		{
		form
		{
			auto_fill_participant_email as "Auto-fill Participant Email"
			{
				type =  form
				form = event_registrations

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Auto-fill the email_address field with the logged-in user's email
										input.email_address = zoho.loginuserid;
										// Disable the email_address field to prevent editing
										disable email_address;
						)
					}
				}

			}
			validate_code_of_conduct as "Validate Code of Conduct"
			{
				type =  form
				form = event_registrations

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if agree_to_code_of_conduct checkbox is not checked
										if(input.agree_to_code_of_conduct == false)
										{
											// Display error message to user
											alert "You must agree to the code of conduct to proceed with registration";
											// Cancel the form submission
											cancel submit;
										}
						)
					}
				}

			}
			send_registration_confirmation as "Send Registration Confirmation"
			{
				type =  form
				form = event_registrations

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Send email confirmation to participant upon successful registration
										if(input.email_address.isNull())
										{
											info "Email address is required for confirmation";
										}
										else
										{
											sendmail
											[
												from :zoho.loginuserid
												to :input.email_address
												subject :"Event Registration Confirmation"
												message :"Dear " + input.participant_name.first_name + ",\n\nThank you for registering for the event. Your registration has been successfully completed.\n\nWe look forward to seeing you there!\n\nBest regards,\nEvent Registration Team"
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			session_date_reminder as "Session Date Reminder"
			{
				type =  schedule
				form = event_registrations
					status = inactive
				start = preferred_session_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch the preferred session date from input
										preferredDate = input.preferred_session_date;
										// Calculate the reminder date (one day before preferred session date)
										reminderDate = preferredDate.addDay(-1);
										// Get the current date
										currentDate = zoho.currentdate;
										// Check if today is the reminder date
										if(currentDate == reminderDate)
										{
											// Prepare email details
											recipientEmail = input.email_address;
											participantName = input.participant_name.first_name;
											eventName = "Event Registration";
											sessionDate = preferredDate.getDateTime();
											// Send reminder email
											sendmail
											[
												from :zoho.loginuserid
												to :recipientEmail
												subject :"Reminder: Your Session is Tomorrow"
												message :"Dear " + participantName + ",\n\nThis is a reminder that your session for " + eventName + " is scheduled for " + sessionDate + ".\n\nWe look forward to seeing you there!\n\nBest regards,\nEvent Team"
											]
										}
					)
					}
				}
			}
		}


